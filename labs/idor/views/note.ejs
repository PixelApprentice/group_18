<!doctype html>
<html>
  <head><meta charset="utf-8"/><title>Note</title></head>
  <body>
    <h1>Note <%= note.id %></h1>
    <% if (typeof success !== 'undefined' && success) { %>
      <div style="background:#e6ffe6;border:1px solid #4caf50;padding:8px;margin-bottom:8px">SUCCESS: You viewed a note belonging to another user (IDOR demonstrated).</div>
    <% } %>
    <p>Owner: <%= note.owner %></p>
    <pre><%= note.content %></pre>
  <p><a href="/lab/idor/">Back to list</a></p>
  </body>
</html>
